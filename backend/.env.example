# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

PORT=3000

# Cadena de conexión de Supabase (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres
DB_SSL=true

# Secreto para firmar los JWT: usa una cadena larga y aleatoria
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# URL del frontend permitido (en local: Vite usa 5173; en producción: la URL de Vercel)
CORS_ORIGIN=http://localhost:5173

# Solo para el script seed:admin (primer usuario administrador)
ADMIN_NOMBRE=Miguel Torres
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CambiaEstaClave123


