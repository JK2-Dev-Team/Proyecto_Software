{
  "name": "lab-dental-backend",
  "version": "0.1.0",
  "description": "API REST del sistema de gestión de citas, órdenes de trabajo e inventario del Laboratorio Dental Miguel Torres",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unitarias",
    "test:integration": "jest --selectProjects integracion --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unitarias",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "integracion",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "globalSetup": "<rootDir>/tests/support/globalSetup.mjs",
        "globalTeardown": "<rootDir>/tests/support/globalTeardown.mjs"
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "statements": 60
      }
    }
  }
}
